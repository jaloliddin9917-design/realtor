# repo root — copied to .env on the server; the API refuses an insecure JWT_SECRET
#
# DATABASE_URL, PHOTO_DIR, TELEGRAM_SESSION_PATH and API_HOST must NOT be added to this
# file. DATABASE_URL is built by deploy/docker-compose.yml from POSTGRES_PASSWORD below;
# PHOTO_DIR, TELEGRAM_SESSION_PATH and API_HOST are baked into the backend/Dockerfile
# image. This file is loaded as compose's env_file for api/worker, and an env_file value
# overrides the image's own ENV default — e.g. copying `PHOTO_DIR=./data/photos` from
# backend/.env.example here would silently move photo storage into the api/worker
# containers' ephemeral filesystem instead of the ./data/photos bind mount, and photos
# would vanish on the next `deploy-up --build`.
DOMAIN=crm.example.uz
# CORS_ORIGINS=https://crm.example.uz   # derived from DOMAIN by docker-compose.yml; set only for a split-origin setup
POSTGRES_PASSWORD=
JWT_SECRET=
# python -c "import secrets; print(secrets.token_urlsafe(48))"  → JWT_SECRET (at least 32 bytes)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# OLX_PROXY_URL=http://user:pass@proxy-host:3128
LOG_LEVEL=INFO
# off-site mirror for deploy/backup.sh (rsync destination, e.g. user@backup-host:/srv/realtor-backups); empty = local only
# backup.sh never deletes from this target (no --delete) — retention there is the target's own policy, not this repo's
BACKUP_TARGET=
