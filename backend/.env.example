# After `make up && make migrate`, bootstrap operator data with the CLI (see
# docs/README.md "Running"), e.g.:
#   python -m app.cli create-user --phone +998901234567 --name "Aziz" --password ...
#   python -m app.cli add-source telegram @some_channel
#   python -m app.cli telegram-login   # needs TELEGRAM_API_ID/TELEGRAM_API_HASH below
DATABASE_URL=postgresql+asyncpg://realtor:realtor@localhost:5432/realtor
TEST_DATABASE_URL=postgresql+asyncpg://realtor:realtor@localhost:5432/realtor_test
PHOTO_DIR=./data/photos
JWT_SECRET=change-me
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telegram.session
LOG_LEVEL=INFO
# DEDUPE_CONFIG_PATH=./config/dedupe.yaml
# HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
# OLX_PROXY_URL=http://user:pass@proxy-host:3128
OLX_REQUEST_INTERVAL=2.0
# photo downloads hit the CDN, not olx.uz, and get their own (faster) budget
OLX_PHOTO_INTERVAL=0.3
OLX_MAX_PAGES=25
TELEGRAM_BACKFILL_DAYS=14
TELEGRAM_RESCAN_LIMIT=200
WORKER_TICK_SECONDS=60
DAILY_JOB_HOUR=3

# API (python -m app.api); CORS_ORIGINS is comma-separated
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
